{
  "name": "faultline-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --require ./scripts/node-userinfo-shim.cjs --import tsx --test tests/*.test.ts",
    "dashboard": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/dashboard/server.ts",
    "spike": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/live-spike.ts",
    "demo": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/cli.ts --mode deterministic",
    "demo:live": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/cli.ts --mode live",
    "incident": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/cli.ts --mode deterministic",
    "incident:live": "node --require ./scripts/node-userinfo-shim.cjs --import tsx src/cli.ts --mode live"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
